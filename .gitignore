Cargo.lock
!fuzz/Cargo.lock
*.jpg
*.jpeg
*.png
*.ppm

# Exception: test fixtures and fuzz seed corpus
!test_ultrahdr.jpg
!fuzz/seed_corpus/**/*.jpg

# === Standard exclusions (do not depend on user ~/.gitignore) ===

# Rust build artifacts
target/

# Fuzz build artifacts, crashes, corpus, and coverage
fuzz/target/
fuzz/artifacts/
fuzz/corpus/
fuzz/coverage/
*.profraw

# Profiling
perf.data
perf.data.old
flamegraph.svg
heaptrack.*.zst
cachegrind.out.*
callgrind.out.*
massif.out.*

# C/C++ build artifacts
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.rlib

# Compiled binaries with no extension
rust_out

# Node
node_modules/

# OS
.DS_Store
Thumbs.db

# Editors
*.swp
*.swo
*~
.idea/
.vscode/
*.iml
