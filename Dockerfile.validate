# Gain map interop validation image
#
# Validates ISO 21496-1 gain map metadata round-trips against third-party
# reference implementations: libultrahdr (JPEG), libavif (AVIF), ExifTool.
#
# Build:
#   docker build -f Dockerfile.validate -t gainmap-validate .
#
# Run all validations:
#   docker run --rm gainmap-validate
#
# Run with local test images:
#   docker run --rm -v /path/to/images:/images gainmap-validate
#
# Interactive:
#   docker run --rm -it gainmap-validate bash

FROM rust:1.93-bookworm

RUN apt-get update && apt-get install -y \
    build-essential cmake ninja-build nasm yasm pkg-config \
    libclang-dev clang git curl ca-certificates \
    libimage-exiftool-perl python3 jq xxd \
    libaom-dev libdav1d-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# ── libultrahdr (JPEG Ultra HDR reference) ──
RUN git clone --depth 1 https://github.com/google/libultrahdr.git && \
    cd libultrahdr && mkdir build && cd build && \
    cmake -G Ninja \
        -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++ \
        -DCMAKE_BUILD_TYPE=Release -DUHDR_BUILD_TESTS=OFF .. && \
    ninja ultrahdr_app && \
    cp ultrahdr_app /usr/local/bin/ && \
    cd /build && rm -rf libultrahdr

# ── libavif 1.2+ (AVIF gain map reference) ──
RUN git clone --depth 1 --branch v1.2.1 https://github.com/AOMediaCodec/libavif.git && \
    cd libavif && mkdir build && cd build && \
    cmake -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DAVIF_CODEC_AOM=SYSTEM \
        -DAVIF_CODEC_DAV1D=SYSTEM \
        -DAVIF_BUILD_APPS=ON \
        -DAVIF_LIBYUV=OFF .. && \
    ninja avifenc avifdec && \
    cp avifenc avifdec /usr/local/bin/ && \
    cp libavif.so* /usr/local/lib/ && ldconfig && \
    cd /build && rm -rf libavif

# Check if avifgainmaputil exists (may be in newer versions)
RUN which avifgainmaputil 2>/dev/null || echo "avifgainmaputil not in this build"

# ── Download sample Ultra HDR images ──
WORKDIR /samples
RUN for i in 01 02 03; do \
        curl -fsSL -o "pixel_ultrahdr_${i}.jpg" \
            "https://raw.githubusercontent.com/MishaalRahmanGH/Ultra_HDR_Samples/main/Originals/Ultra_HDR_Samples_Originals_${i}.jpg" 2>/dev/null && \
        echo "Downloaded pixel_ultrahdr_${i}.jpg" || true; \
    done

WORKDIR /workspace
COPY validate_gainmap.sh /usr/local/bin/validate_gainmap
RUN chmod +x /usr/local/bin/validate_gainmap

# Verify tools are present
RUN ultrahdr_app 2>&1 | head -1 && \
    avifenc --version 2>&1 | head -1 && \
    avifdec --version 2>&1 | head -1 && \
    exiftool -ver

CMD ["validate_gainmap"]
